            </button-visual-state>
          </button>
        </zone>
        <zone forceUpdate='true' h='29025' id='14' type-v2='text' w='65902' x='33253' y='68860'>
          <formatted-text>
            <run bold='true' fontcolor='#000000' fontname='Benton Sans Book'>New Zealand has the highest CSU at</run>
            <run bold='true' fontcolor='#e15759' fontname='Benton Sans Book'> 16,862</run>
            <run bold='true' fontcolor='#000000' fontname='Benton Sans Book'>, while Nigeria records the lowest CSU at </run>
            <run bold='true' fontcolor='#e15759' fontname='Benton Sans Book'>5,043</run>
            <run bold='true' fontcolor='#000000' fontname='Benton Sans Book'>.</run>
            <run>Æ&#10;&#10;</run>
            <run bold='true' fontcolor='#000000' fontname='Benton Sans Book'>Rural areas have the highest CSU at </run>
            <run bold='true' fontcolor='#e15759' fontname='Benton Sans Book'>102,846</run>
            <run bold='true' fontcolor='#000000' fontname='Benton Sans Book'>, approximately </run>
            <run bold='true' fontcolor='#e15759' fontname='Benton Sans Book'>7.4%</run>
