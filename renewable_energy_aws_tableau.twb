          <button action='tabdoc:goto-sheet window-id=&quot;{0DD49BAD-C75B-4717-A4C0-C29B851F2BD9}&quot;' button-type='text'>
            <button-visual-state>
              <caption>CSU</caption>
              <button-caption-font-style fontcolor='#ffffff' fontname='Tableau Bold' fontsize='12' />
              <format attr='background-color' value='#b8b49e' />
              <format attr='border-style' value='dashed' />
              <format attr='border-width' value='1' />
